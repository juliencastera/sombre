{
  "name": "sombre",
  "description": "Dark mode for every website: no white flash, guaranteed text contrast, instant toggle.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:setup": "node bench/scripts/setup.ts",
    "bench:record": "node bench/scripts/record.ts",
    "bench": "node bench/run.ts",
    "test:e2e": "wxt build && playwright test",
    "fixes:keygen": "node scripts/fixes-keygen.ts",
    "fixes:sign": "node scripts/sign-fixes.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@wxt-dev/module-svelte": "2.0.5",
    "fflate": "0.8.3",
    "pngjs": "7.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  }
}
